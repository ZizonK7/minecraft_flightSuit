{
  "version": 3,
  "name": "spin_attack",
  "author": "flightsuit",
  "description": "Spin attack: crouch, sword arm swung out to the side, one full turn of the whole body.",
  "emote": {
    "beginTick": 0,
    "endTick": 10,
    "stopTick": 14,
    "isLoop": false,
    "returnTick": 0,
    "degrees": true,
